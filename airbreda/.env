# Environment for docker compose (task 004). PLACEHOLDER VALUES ONLY.
# This file is gitignored (.gitignore: .env) and excluded from every Docker
# build context (.dockerignore). Fill in real values locally, never commit them.
# Write values without quotes: env_file passes quotes on as part of the value.

# --- src/ingest_air.py: PostgreSQL (RDS) connection, libpq variable names (D-021)
PGHOST=replace-with-rds-endpoint.invalid
PGPORT=5432
PGDATABASE=airbreda
PGUSER=airbreda_admin
PGPASSWORD=replace-with-db-password
PGSSLMODE=require

# --- src/ingest_traffic.py: S3 upload
AIRBREDA_BUCKET=airbreda-replace-with-suffix
AWS_REGION=eu-west-1
# The container cannot see the laptop's ~/.aws profile, so boto3 reads the
# access key from these two variables instead. Leave AWS_PROFILE unset here:
# boto3 would look for that profile inside the container and fail (exit 3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# Optional, default "data" (= /app/data in the image):
# AIRBREDA_DATA_DIR=data
